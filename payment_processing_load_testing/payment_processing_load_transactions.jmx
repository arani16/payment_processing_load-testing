                <stringProp name="Argument.value">{&#xd;
  &quot;processorTransactionId&quot;: &quot;${processorTransactionId_api12}&quot;,&#xd;
  &quot;processorTransactionBatchId&quot;: &quot;123410001&quot;,&#xd;
  &quot;shaHash&quot;: &quot;${shaHash_api12}&quot;,&#xd;
