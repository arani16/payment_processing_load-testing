  &quot;payor&quot;: {&#xd;
    &quot;accountNumber&quot;: &quot;${dynamicAccountNumber}&quot;,&#xd;
    &quot;bankAccountType&quot;: &quot;CHECKING&quot;,&#xd;
    &quot;name&quot;: &quot;${creditHolderName_api12}&quot;,&#xd;
    &quot;routingNumber&quot;: &quot;101019644&quot;,&#xd;
    &quot;address&quot;: {&#xd;
      &quot;addressLineOne&quot;: &quot;456 Elm St, Grand Rapids&quot;,&#xd;
      &quot;addressLineTwo&quot;: &quot;22St Mary’s Road&quot;,&#xd;
      &quot;city&quot;: &quot;France&quot;,&#xd;
