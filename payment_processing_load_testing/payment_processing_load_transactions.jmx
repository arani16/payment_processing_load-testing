              <elementProp name="" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.value">{&#xd;
  &quot;processorTransactionId&quot;: &quot;${processorTransactionId_api7}&quot;,&#xd;
  &quot;processorTransactionBatchId&quot;: &quot;123410001&quot;,&#xd;
  &quot;shaHash&quot;: &quot;${shaHash_api7}&quot;,&#xd;
  &quot;amount&quot;: &quot;${amount_api7}&quot;,&#xd;
  &quot;paymentType&quot;: &quot;EXPRESS_ACH&quot;,&#xd;
  &quot;payor&quot;: {&#xd;
    &quot;accountNumber&quot;: &quot;${dynamicAccountNumber}&quot;,&#xd;
    &quot;bankAccountType&quot;: &quot;SAVINGS&quot;,&#xd;
    &quot;name&quot;: &quot;${creditHolderName_api7}&quot;,&#xd;
    &quot;routingNumber&quot;: &quot;125000105&quot;,&#xd;
    &quot;address&quot;: {&#xd;
      &quot;addressLineOne&quot;: &quot;102 Maple, AustinTheory&quot;,&#xd;
      &quot;addressLineTwo&quot;: &quot;Xyza RoadoffTour&quot;,&#xd;
      &quot;city&quot;: &quot;Africa&quot;,&#xd;
      &quot;state&quot;: &quot;PA&quot;,&#xd;
      &quot;postalCode&quot;: &quot;20701&quot;,&#xd;
      &quot;countryCode&quot;: &quot;US&quot;&#xd;
    },&#xd;
    &quot;counterPartyType&quot;: &quot;INDIVIDUAL&quot;&#xd;
