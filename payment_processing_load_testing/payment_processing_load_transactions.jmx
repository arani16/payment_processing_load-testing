        <hashTree>
          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Pre Script" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">import org.apache.commons.codec.digest.HmacUtils
import java.util.concurrent.atomic.AtomicInteger
import java.util.concurrent.ThreadLocalRandom
import java.util.UUID
import com.github.javafaker.Faker

try {
    // ==============================
    // Timestamp &amp; Random values
    // ==============================
    def timestamp = System.currentTimeMillis()
    def rnd = ThreadLocalRandom.current()
    def randomSuffix = String.format(&quot;%04d&quot;, rnd.nextInt(10000))
    def random3a = UUID.randomUUID().toString().replace(&quot;-&quot;, &quot;&quot;).substring(0, 3).toUpperCase()
    def random3b = UUID.randomUUID().toString().replace(&quot;-&quot;, &quot;&quot;).substring(0, 3).toUpperCase()

    // ==============================
 	// Generate Unique Account Number (Best of Both)
	// ==============================
	if (!props.containsKey(&quot;ACCOUNT_NUMBER_COUNTER&quot;)) {
	    def runId = (System.currentTimeMillis() % 100000000).toInteger()  // Last 8 digits of timestamp
	    def startNumber = 600000000 + runId
	    props.put(&quot;ACCOUNT_NUMBER_COUNTER&quot;, new AtomicInteger(startNumber))
	    log.info(&quot;Account counter initialized at: ${startNumber} for this test run&quot;)
	}

	def accountCounter = (props.get(&quot;ACCOUNT_NUMBER_COUNTER&quot;) as AtomicInteger).incrementAndGet()
	def accountLength = 9 + rnd.nextInt(8)
	def dynamicAccountNumber = String.format(&quot;%0${accountLength}d&quot;, accountCounter)
	vars.put(&quot;dynamicAccountNumber&quot;, dynamicAccountNumber)

    // ==============================
    // Faker – person name
    // ==============================
    def faker = new Faker()
    def fakeName = faker.name().fullName()

    // ==============================
    // Total members
    // ==============================
    def totalMembers = vars.get(&quot;TOTAL_MEMBERS&quot;)?.toInteger()
    def memberPrefix = &quot;accessId_&quot;

    if (!totalMembers || totalMembers &lt;= 0) {
        log.error(&quot;TOTAL_MEMBERS is not set or invalid&quot;)
        return
    }

    // ==============================
    // Global counter (thread-safe)
    // ==============================
    if (!props.containsKey(&quot;GLOBAL_COUNTER&quot;)) {
        props.put(&quot;GLOBAL_COUNTER&quot;, new AtomicInteger(0))
    }
    def counter = (props.get(&quot;GLOBAL_COUNTER&quot;) as AtomicInteger).incrementAndGet()

    // ==============================
    // Detect available members
    // ==============================
    def actualTotalMembers = 0
    for (int i = 1; i &lt;= totalMembers; i++) {
        if (vars.get(memberPrefix + i)) {
            actualTotalMembers++
        }
    }
    if (actualTotalMembers == 0) {
        log.error(&quot;No member variables found!&quot;)
        return
    }

    // ==============================
    // Round-robin member selection
    // ==============================
    def memberIndex = ((counter - 1) % actualTotalMembers) + 1

    // ==============================
    // Fetch member variables
    // ==============================
    def accessId = vars.get(&quot;accessId_&quot; + memberIndex)
    def accessKey = vars.get(&quot;accessKey_&quot; + memberIndex)
    def accessSecret = vars.get(&quot;accessSecret_&quot; + memberIndex)
    def accountId = vars.get(&quot;accountId_&quot; + memberIndex)
    def accountNumber = vars.get(&quot;accountNumber_&quot; + memberIndex)
    def creditHolderName = vars.get(&quot;memberName&quot; + memberIndex)

    if (!accessId || !accessSecret || !accountId || !accountNumber) {
        log.error(&quot;Missing credentials for member &quot; + memberIndex)
        return
    }

    // ==============================
    // Set request variables
    // ==============================
    vars.put(&quot;accessId&quot;, accessId)
    vars.put(&quot;accessKey&quot;, accessKey)
    vars.put(&quot;accessSecret&quot;, accessSecret)
    vars.put(&quot;requestorAccountId&quot;, accountId)
    vars.put(&quot;accountNumber&quot;, accountNumber)
    vars.put(&quot;creditHolderName&quot;, creditHolderName)

    log.info(&quot;Using Member ${memberIndex}/${actualTotalMembers} | accessId=${accessId} | counter=${counter}&quot;)

    // ==============================
    // PreNote amount is always zero
    // ==============================
    def amount = &quot;0.00&quot;
    vars.put(&quot;amount_api11&quot;, amount)

    // ==============================
    // Processor Transaction ID
    // ==============================
    def processorTransactionId = &quot;TXN_${timestamp}_${random3a}_${randomSuffix}&quot;
    vars.put(&quot;processorTransactionId_api11&quot;, processorTransactionId)

    // ==============================
    // SHA-256 HMAC generation
    // ==============================
    def inputString = &quot;${accountId}_${amount}_${accountNumber}_${processorTransactionId}&quot;
    def shaHash = HmacUtils.hmacSha256Hex(accessSecret, inputString)
    vars.put(&quot;shaHash_api11&quot;, shaHash)

    // ==============================
    // New Merchant Name
    // ==============================
    def cleanName = fakeName.replaceAll(&quot;[^a-zA-Z0-9 ]&quot;, &quot;&quot;)
    vars.put(&quot;creditHolderName_api11&quot;, &quot;${cleanName}_${randomSuffix}_${random3b}&quot;)

} catch (Exception e) {
    log.error(&quot;Error in API 11 PreNote_credit:&quot;, e)
    throw e
}
</stringProp>
