    def creditHolderName = vars.get(&quot;memberName&quot; + memberIndex)

    if (!accessId || !accessSecret || !accountId || !accountNumber) {
        log.error(&quot;Missing credentials for member &quot; + memberIndex)
        return
    }

    // ==============================
    // Set request variables
    // ==============================
    vars.put(&quot;accessId&quot;, accessId)
    vars.put(&quot;accessKey&quot;, accessKey)
    vars.put(&quot;accessSecret&quot;, accessSecret)
    vars.put(&quot;requestorAccountId&quot;, accountId)
    vars.put(&quot;accountNumber&quot;, accountNumber)
    vars.put(&quot;creditHolderName&quot;, creditHolderName)

    log.info(&quot;Using Member ${memberIndex}/${actualTotalMembers} | accessId=${accessId} | counter=${counter}&quot;)

        
    // Merchant Round-Robin Selection
    // ==============================
    def totalMerchants = vars.get(&quot;TOTAL_MERCHANTS&quot;)?.toInteger()

    if (!totalMerchants || totalMerchants &lt;= 0) {
        log.error(&quot;TOTAL_MERCHANTS is not set or invalid&quot;)
        return
    }

    // Global counter for merchants (thread-safe, separate from member counter)
    if (!props.containsKey(&quot;GLOBAL_MERCHANT_COUNTER&quot;)) {
        props.put(&quot;GLOBAL_MERCHANT_COUNTER&quot;, new AtomicInteger(0))
    }

    def merchantCounter = (props.get(&quot;GLOBAL_MERCHANT_COUNTER&quot;) as AtomicInteger).incrementAndGet()
    def merchantIndex = ((merchantCounter - 1) % totalMerchants) + 1

    def selectedMerchant = vars.get(&quot;existing_individualMerchant_&quot; + merchantIndex)

    if (!selectedMerchant) {
        log.error(&quot;Merchant not found for index: &quot; + merchantIndex)
        return
    }

    vars.put(&quot;creditHolderName_api4&quot;, selectedMerchant)

    log.info(&quot;Using Merchant ${merchantIndex}/${totalMerchants} -&gt; ${selectedMerchant} | merchantCounter=${merchantCounter}&quot;)


    // ==============================
    // Random Amount
    // ==============================
    def amount = (rnd.nextInt(900) + 1).toString()
    vars.put(&quot;amount_api4&quot;, amount)
    log.info(&quot;Generated amount_api4 = &quot; + amount)

    // ==============================
    // Processor Transaction ID
    // ==============================
    def processorTransactionId = &quot;TXN_${timestamp}_${random4}_${randomSuffix}&quot;
    vars.put(&quot;processorTransactionId_api4&quot;, processorTransactionId)

    // ==============================
    // SHA-256 HMAC generation
    // ==============================
    def inputString = &quot;${accountId}_${amount}_${accountNumber}_${processorTransactionId}&quot;
    log.info(&quot;API4 SHA inputString: &quot; + inputString)

    def shaHash = HmacUtils.hmacSha256Hex(accessSecret, inputString)
    vars.put(&quot;shaHash_api4&quot;, shaHash)

    log.info(&quot;SHA256 Generated Successfully&quot;)

} catch (Exception e) {
    log.error(&quot;Error in API4 credit standard ach (existing Individual Merchant):&quot;, e)
    throw e
}
</stringProp>
