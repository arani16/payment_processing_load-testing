          <stringProp name="HTTPSampler.method">POST</stringProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
            <collectionProp name="Arguments.arguments">
              <elementProp name="" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.value">{&#xd;
  &quot;processorTransactionId&quot;: &quot;${processorTransactionId_api1}&quot;,&#xd;
  &quot;processorTransactionBatchId&quot;: &quot;123410001&quot;,&#xd;
  &quot;shaHash&quot;: &quot;${shaHash_api1}&quot;,&#xd;
  &quot;amount&quot;: &quot;${amount_api1}&quot;,&#xd;
  &quot;paymentType&quot;: &quot;STANDARD_ACH&quot;,&#xd;
  &quot;receiver&quot;: {&#xd;
    &quot;accountNumber&quot;: &quot;${dynamicAccountNumber}&quot;,&#xd;
    &quot;bankAccountType&quot;: &quot;SAVINGS&quot;,&#xd;
    &quot;name&quot;: &quot;${creditHolderName_api1}&quot;,&#xd;
    &quot;routingNumber&quot;: &quot;075000022&quot;,&#xd;
    &quot;address&quot;: {&#xd;
      &quot;addressLineOne&quot;: &quot;133 Macdougal Speru&quot;,&#xd;
      &quot;addressLineTwo&quot;: &quot;380 Harrogate Road&quot;,&#xd;
      &quot;city&quot;: &quot;Florida&quot;,&#xd;
      &quot;state&quot;: &quot;AZ&quot;,&#xd;
      &quot;postalCode&quot;: &quot;62701&quot;,&#xd;
      &quot;countryCode&quot;: &quot;US&quot;&#xd;
    },&#xd;
    &quot;counterPartyType&quot;: &quot;INDIVIDUAL&quot;&#xd;
  }&#xd;
